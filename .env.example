# Copy to .env (git-ignored) and set a real password: cp .env.example .env
#
# SQL Server rejects weak passwords and won't start: use at least 8 characters
# from 3 of these 4 groups: uppercase, lowercase, digits, symbols.
# Avoid $ ; ' " and spaces. $ is read as a variable by Docker Compose, and ;
# ends a value in the connection string.
#
# The same password goes into the API's user secrets in Phase 1.1.
# SQL Server keeps the password it first started with. To change it later,
# wipe the volume: docker compose down -v (this deletes the local database).
MSSQL_SA_PASSWORD=ChangeMe_Str0ng
